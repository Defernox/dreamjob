# --- Identite aupres des sources interrogees ---
# Ajoutee au User-Agent : permet a une source de vous contacter plutot que
# de vous bloquer. Laisser vide est possible, mais moins courtois.
CONTACT_EMAIL=

# --- LLM (obligatoire pour l'import de CV, l'extraction et la lettre de motivation) ---
# Sans clé, l'app fonctionne en mode dégradé : scoring lexical uniquement, pas de lettre générée.
ANTHROPIC_API_KEY=
# Requis UNIQUEMENT si votre cle est liee a une identite (l'API repond alors
# « anthropic-workspace-id is required »). Se trouve dans l'URL de la console
# Anthropic quand vous ouvrez le workspace : .../workspaces/wrkspc_XXXX
ANTHROPIC_WORKSPACE_ID=

# --- France Travail (https://francetravail.io) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Civiweb / Business France (V.I.E) ---
# Facultatif : le connecteur utilise par defaut la cle publiee dans la
# configuration front du site. A renseigner seulement si elle change.
CIVIWEB_API_KEY=
